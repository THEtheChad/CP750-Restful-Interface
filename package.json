{
  "name": "cp750",
  "private": true,
  "type": "module",
  "description": "REST + SSE gateway and web client for the Dolby CP750 Digital Cinema Processor.",
  "repository": {
    "type": "git",
    "url": "https://github.com/THEtheChad/CP750-Restful-Interface.git"
  },
  "author": "Chad Elliott",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "gen": "bun run --filter '*' gen",
    "gen:check": "bun run --filter '*' gen:check",
    "check": "bun run lint && bun run typecheck && bun run gen:check && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
