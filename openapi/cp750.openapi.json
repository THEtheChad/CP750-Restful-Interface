{
  "openapi": "3.1.0",
  "info": {
    "description": "REST + SSE gateway for the Dolby CP750 Digital Cinema Processor. Param names and value types depend on the unit's firmware: discover them with `GET /api/commands`, which returns each param's JSON Schema. Errors are RFC 9457 `application/problem+json`.\n\n**Request rules.** Every request's `Host` must be localhost, 127.0.0.1, [::1], the listen address or one of `CP750_ALLOWED_HOSTS` (any port), else `421 HOST_NOT_ALLOWED` (DNS-rebinding defence). `PUT` and `POST` must be `Content-Type: application/json`, even with no body (`415 UNSUPPORTED_MEDIA_TYPE`), and at most 4 KiB (`413 PAYLOAD_TOO_LARGE`). They are refused with `403 ORIGIN_NOT_ALLOWED` when the browser marks them cross-site (`Sec-Fetch-Site: cross-site`) or their `Origin` is neither this server nor listed in `CP750_CORS_ORIGIN`. CORS is off unless `CP750_CORS_ORIGIN` lists origins. A known path with an unsupported method is `405 METHOD_NOT_ALLOWED` with `Allow`; an unknown one is `404 NOT_FOUND`.",
    "license": {
      "name": "MIT"
    },
    "title": "CP750 REST gateway",
    "version": "0.1.0"
  },
  "tags": [
    {
      "description": "Health, device state and this document",
      "name": "system"
    },
    {
      "description": "Read and write CP750 parameters",
      "name": "params"
    },
    {
      "description": "Trigger CP750 actions (`cp750.ctrl.*`)",
      "name": "actions"
    },
    {
      "description": "Server-sent events",
      "name": "events"
    }
  ],
  "paths": {
    "/api/actions/{name}": {
      "post": {
        "description": "Sends an `action` param (`cp750.ctrl.*`); `value` defaults to 1. Destructive actions (reboot, default_params, log_erase…) need `confirm: true`. The request must be `Content-Type: application/json` even without a body; an empty body counts as `{}`.",
        "operationId": "triggerAction",
        "parameters": [
          {
            "description": "Parameter name or alias, case-insensitive. The set depends on the firmware; discover it with `GET /api/commands`.",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "description": "Parameter name or alias, case-insensitive. The set depends on the firmware; discover it with `GET /api/commands`.",
              "example": "cp750.sys.fader",
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionRequest"
              }
            }
          },
          "description": "Optional; an empty body counts as `{}`. `Content-Type: application/json` is required either way.",
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            },
            "description": "The unit's reply"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "INVALID_VALUE",
                  "detail": "Invalid value",
                  "errors": [
                    "must be <= 100"
                  ],
                  "param": "cp750.sys.fader",
                  "status": 400,
                  "title": "Invalid value",
                  "type": "urn:cp750:problem:invalid-value"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid request body, value or name (`BAD_REQUEST`, `INVALID_VALUE`)"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "UNAUTHORIZED",
                  "detail": "Unauthorized",
                  "status": 401,
                  "title": "Unauthorized",
                  "type": "urn:cp750:problem:unauthorized"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing or wrong Bearer token (`UNAUTHORIZED`)"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "FORBIDDEN",
                  "detail": "Forbidden",
                  "param": "cp750.sys.fader",
                  "reason": "read-only-mode",
                  "status": 403,
                  "title": "Forbidden",
                  "type": "urn:cp750:problem:forbidden"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Refused by the access policy (`FORBIDDEN`, see `reason`), or a cross-site request whose `Origin` is not allowed (`ORIGIN_NOT_ALLOWED`)"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "UNKNOWN_PARAMETER",
                  "detail": "Unknown parameter",
                  "param": "cp750.sys.nope",
                  "status": 404,
                  "title": "Unknown parameter",
                  "type": "urn:cp750:problem:unknown-parameter"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown parameter or route (`UNKNOWN_PARAMETER`, `NOT_FOUND`)"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "PAYLOAD_TOO_LARGE",
                  "detail": "Request body too large",
                  "status": 413,
                  "title": "Request body too large",
                  "type": "urn:cp750:problem:payload-too-large"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request body is larger than the server accepts (`PAYLOAD_TOO_LARGE`)"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "UNSUPPORTED_MEDIA_TYPE",
                  "detail": "Unsupported media type",
                  "status": 415,
                  "title": "Unsupported media type",
                  "type": "urn:cp750:problem:unsupported-media-type"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request body is not `application/json` (`UNSUPPORTED_MEDIA_TYPE`)"
          },
          "421": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "HOST_NOT_ALLOWED",
                  "detail": "Host not allowed",
                  "status": 421,
                  "title": "Host not allowed",
                  "type": "urn:cp750:problem:host-not-allowed"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The `Host` header is not one this server answers to (`HOST_NOT_ALLOWED`); see `CP750_ALLOWED_HOSTS`"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "INTERNAL",
                  "detail": "Internal server error",
                  "status": 500,
                  "title": "Internal server error",
                  "type": "urn:cp750:problem:internal"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unexpected server error (`INTERNAL`)"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "NOT_CONNECTED",
                  "detail": "Not connected to the CP750",
                  "status": 503,
                  "title": "Not connected to the CP750",
                  "type": "urn:cp750:problem:not-connected"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not connected to the CP750 (`NOT_CONNECTED`)"
          },
          "504": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "TIMEOUT",
                  "detail": "The CP750 did not answer",
                  "status": 504,
                  "title": "The CP750 did not answer",
                  "type": "urn:cp750:problem:timeout"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The CP750 did not answer in time (`TIMEOUT`)"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "summary": "Trigger an action",
        "tags": [
          "actions"
        ]
      }
    },
    "/api/commands": {
      "get": {
        "description": "Every param the active firmware manifest (and `help`) knows, with its value JSON Schema, availability and the operations allowed right now. Empty before the first firmware detection.",
        "operationId": "listCommands",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Commands"
                }
              }
            },
            "description": "The command list"
          },
          "421": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "HOST_NOT_ALLOWED",
                  "detail": "Host not allowed",
                  "status": 421,
                  "title": "Host not allowed",
                  "type": "urn:cp750:problem:host-not-allowed"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The `Host` header is not one this server answers to (`HOST_NOT_ALLOWED`); see `CP750_ALLOWED_HOSTS`"
          }
        },
        "summary": "Parameters of the active manifest",
        "tags": [
          "params"
        ]
      }
    },
