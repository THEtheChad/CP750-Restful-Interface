{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/THEtheChad/CP750-Restful-Interface/packages/manifests/schema/cp750-manifest.v1.schema.json",
  "title": "CP750 firmware manifest, format version 1",
  "description": "Describes the ASCII command set of one Dolby CP750 firmware version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "firmware", "status", "sources", "params", "commands"],
  "properties": {
    "$schema": { "type": "string" },
    "manifestVersion": { "const": 1 },
    "firmware": { "$ref": "#/$defs/firmware" },
    "status": {
      "description": "draft = not yet checked against a real unit's help output",
      "enum": ["verified", "draft"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "params": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/paramName" },
      "additionalProperties": { "$ref": "#/$defs/param" }
    },
    "commands": {
      "description": "Single-word commands the unit accepts.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
    }
  },
  "$defs": {
    "firmware": {
      "description": "Dot-separated non-negative integers of any length, e.g. 1.0.0.150183.",
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*$"
    },
    "paramName": {
      "description": "Canonical lowercase parameter name: exactly cp750.<category>.<parameter>. The device layer (help parsing, raw reads) assumes three segments.",
      "type": "string",
      "pattern": "^cp750\\.[a-z0-9_]+\\.[a-z0-9_]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["manual", "capture"] },
        "ref": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "access", "accessSource", "value"],
      "properties": {
        "tier": { "enum": ["normal", "full"] },
        "access": { "enum": ["readwrite", "readonly", "action"] },
        "accessSource": { "enum": ["manual", "inferred", "observed"] },
        "value": { "$ref": "#/$defs/valueSchema" },
        "unit": { "enum": ["fader", "ms", "us", "dB_tenths", "feet_or_meters"] },
        "destructive": { "type": "boolean" },
        "internal": { "type": "boolean" },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_.]+$" }
        },
        "description": { "type": "string", "minLength": 1 }
      },
      "if": { "required": ["destructive"], "properties": { "destructive": { "const": true } } },
      "then": {
        "description": "Only actions can be destructive (the confirmation is an action's).",
        "properties": { "access": { "const": "action" } }
      }
    },
    "valueSchema": {
      "description": "The JSON Schema (2020-12) of a parameter's JSON value. Restricted to the shapes the codec supports.",
      "oneOf": [{ "$ref": "#/$defs/integerValue" }, { "$ref": "#/$defs/stringValue" }]
    },
    "integerValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "integer" },
        "minimum": { "type": "integer" },
        "maximum": { "type": "integer" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer" }
        }
      }
    },
    "stringValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "string" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\S+$" }
        },
        "maxLength": { "type": "integer", "minimum": 0 },
        "x-format": {
          "description": "Wire format hint. route-list: [L R C Sw Ls Rs 7 8]-style lists (exact syntax unverified). ip-setting: [ip nm gw off|on hostname].",
          "enum": ["route-list", "ip-setting"]
        }
      }
    }
  }
}
